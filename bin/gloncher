#!/usr/bin/env bash
# gloncher — detect the OS/arch and exec the matching gloncher binary.
#
# Binaries are named gloncher-<os>-<arch>[.exe] to match the release matrix in
# the Makefile. Change one, change the other. binaries/ holds the copies
# committed to the repo, so this works with no Go toolchain present.
#
# This script is installable with basher (basher install pforret/gloncher),
# which puts a *symlink* to it on your PATH. Everything below therefore
# resolves the symlink chain first: $0 and ${BASH_SOURCE[0]} point at the
# symlink, not at the repository holding the binaries.

set -euo pipefail

# resolve follows a chain of symlinks to the real file, without depending on
# `readlink -f`, which BSD/macOS did not have for years.
resolve() {
  local path="$1" target dir
  while [[ -L "$path" ]]; do
    target="$(readlink "$path")"
    if [[ "$target" == /* ]]; then
      path="$target"
    else
      path="$(cd "$(dirname "$path")" && pwd)/$target"
    fi
  done
  dir="$(cd "$(dirname "$path")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

self="$(resolve "${BASH_SOURCE[0]}")"
here="$(dirname "$self")"
# The script lives in bin/ inside the repo; binaries sit at the repo root.
root="$here"
[[ "$(basename "$here")" == "bin" ]] && root="$(dirname "$here")"

case "$(uname -s)" in
  Darwin)                     os="darwin"  ;;
  Linux)                      os="linux"   ;;
  CYGWIN* | MINGW* | MSYS*)   os="windows" ;;
  *) echo "gloncher: unsupported OS $(uname -s)" >&2; exit 1 ;;
esac

case "$(uname -m)" in
  x86_64 | amd64)   arch="amd64" ;;
  arm64 | aarch64)  arch="arm64" ;;
  *) echo "gloncher: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

name="gloncher-${os}-${arch}"
plain="gloncher"
if [[ "$os" == "windows" ]]; then
  name="${name}.exe"
  plain="gloncher.exe"
fi

# Release bundles carry per-platform names; a plain `make build` in a checkout
# produces ./gloncher. Accept either, so both layouts work.
for candidate in \
  "$root/$name" "$root/binaries/$name" "$root/dist/$name" "$root/bin/$name" \
  "$root/$plain" "$root/dist/$plain"
do
  # Never exec ourselves: release bundles symlink dist/gloncher to this script,
  # which would otherwise recurse forever when the platform binary is missing.
  if [[ -x "$candidate" && -f "$candidate" && ! "$candidate" -ef "$self" ]]; then
    exec "$candidate" "$@"
  fi
done

# Nothing prebuilt. In a source checkout with Go available — which is what
# basher installs — build it once, then exec it. Beats telling someone to run
# a command we could have run ourselves.
if [[ -f "$root/go.mod" ]] && command -v go >/dev/null 2>&1; then
  echo "gloncher: first run, building ${name}..." >&2
  if (cd "$root" && go build -o "$name" .); then
    exec "$root/$name" "$@"
  fi
  echo "gloncher: build failed" >&2
  exit 1
fi

echo "gloncher: no binary for ${os}/${arch} (looked for $name in $root)" >&2
echo "build one with: make build   — or: make release for all platforms" >&2
exit 1
