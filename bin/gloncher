#!/usr/bin/env bash
# gloncher — detect the OS/arch and exec the matching gloncher binary.
#
# Binaries are named gloncher-<os>-<arch>[.exe] to match the release matrix in
# the Makefile. Change one, change the other. binaries/ holds the copies
# committed to the repo, so this works with no Go toolchain present.
#
# This script is installable with basher (basher install pforret/gloncher),
# which puts a *symlink* to it on your PATH. Everything below therefore
# resolves the symlink chain first: $0 and ${BASH_SOURCE[0]} point at the
# symlink, not at the repository holding the binaries.

set -euo pipefail

# resolve follows a chain of symlinks to the real file, without depending on
# `readlink -f`, which BSD/macOS did not have for years.
resolve() {
  local path="$1" target dir
  while [[ -L "$path" ]]; do
    target="$(readlink "$path")"
    if [[ "$target" == /* ]]; then
      path="$target"
    else
      path="$(cd "$(dirname "$path")" && pwd)/$target"
    fi
  done
  dir="$(cd "$(dirname "$path")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

self="$(resolve "${BASH_SOURCE[0]}")"
here="$(dirname "$self")"
# The script lives in bin/ inside the repo; binaries sit at the repo root.
root="$here"
[[ "$(basename "$here")" == "bin" ]] && root="$(dirname "$here")"

platform() {
  local os arch
  case "$(uname -s)" in
    Darwin)                     os="darwin"  ;;
    Linux)                      os="linux"   ;;
    CYGWIN* | MINGW* | MSYS*)   os="windows" ;;
    *) echo "gloncher: unsupported OS $(uname -s)" >&2; return 1 ;;
  esac
  case "$(uname -m)" in
    x86_64 | amd64)   arch="amd64" ;;
    arm64 | aarch64)  arch="arm64" ;;
    *) echo "gloncher: unsupported architecture $(uname -m)" >&2; return 1 ;;
  esac
  printf '%s %s\n' "$os" "$arch"
}

read -r os arch <<< "$(platform)"

name="gloncher-${os}-${arch}"
plain="gloncher"
if [[ "$os" == "windows" ]]; then
  name="${name}.exe"
  plain="gloncher.exe"
fi

# find_binary echoes the binary this platform should run, or nothing if there
# is none yet. Release bundles carry per-platform names; a plain `make build`
# in a checkout produces ./gloncher. Accept either, so both layouts work, and
# prefer a local build over the committed one so a developer's own binary is
# never shadowed by a stale copy.
find_binary() {
  local candidate
  for candidate in \
    "$root/$name" "$root/binaries/$name" "$root/dist/$name" "$root/bin/$name" \
    "$root/$plain" "$root/dist/$plain"
  do
    # Never return ourselves: release bundles symlink dist/gloncher to this
    # script, which would otherwise recurse forever.
    if [[ -x "$candidate" && -f "$candidate" && ! "$candidate" -ef "$self" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

# build compiles the binary for this platform, if there is a toolchain and a
# source tree to build from.
build() {
  if [[ ! -f "$root/go.mod" ]]; then
    echo "gloncher: no source tree at $root to build from" >&2
    return 1
  fi
  if ! command -v go >/dev/null 2>&1; then
    echo "gloncher: no Go toolchain to build with" >&2
    return 1
  fi
  echo "gloncher: building ${name}..." >&2
  (cd "$root" && go build -o "$name" .)
}

launcher_help() {
  cat <<EOF
gloncher — run several programs at once in one terminal screen

usage:
  gloncher [options] <name.ini>

launcher options (handled by this script):
  -w, --which     print the path of the binary that would run, and exit
  -B, --build     rebuild the binary from source before running
  -h, --help      print this help and exit

program options (passed to the binary):
  -i, --init      write a commented template INI file (default gloncher.ini)
  -c, --check     parse the INI file, print what it would run, and exit
  -v, --version   print version and exit

keys:
  q, ctrl-c       stop every program and quit

platform: ${os}/${arch}
binary:   $(find_binary || echo "none built yet")
EOF
}

force_build="false"
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      launcher_help
      exit 0
      ;;
    -w | --which)
      binary="$(find_binary)" || { echo "gloncher: no binary for ${os}/${arch}" >&2; exit 1; }
      printf '%s\n' "$binary"
      exit 0
      ;;
    -B | --build)
      force_build="true"
      shift
      ;;
    --)
      # Everything after -- belongs to the binary.
      shift
      break
      ;;
    *)
      # Not ours: hand it and the rest to the binary.
      break
      ;;
  esac
done

if [[ "$force_build" == "true" ]]; then
  build || exit 1
fi

if ! binary="$(find_binary)"; then
  # Nothing prebuilt for this platform. In a source checkout with Go
  # available, build it once — beats telling someone to run a command we
  # could have run ourselves.
  build || {
    echo "gloncher: no binary for ${os}/${arch} (looked for $name in $root)" >&2
    echo "build one with: make build   — or: make release for all platforms" >&2
    exit 1
  }
  binary="$(find_binary)"
fi

exec "$binary" "$@"
